# ===== 复制成 .env 后填写（.env 已被 gitignore，不会进仓库）=====

# AI 对话（默认走 DeepSeek，见 server/services/openai.js 的 PROVIDER_URLS）
# DeepSeek 用 sk- 开头的 key；换 OpenAI / Moonshot / 通义 / 智谱 就填对应家的 key
OPENAI_API_KEY=

# 声音克隆 + 语音回复（ElevenLabs Instant Voice Clone）
ELEVENLABS_API_KEY=

# 阿里云：短信验证码注册 + 手机号一键登录
# 权限建议只给「短信服务」+「号码认证」，不要开公网白名单
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# Fish Audio（备用 TTS，代码已写但未接入）
FISH_AUDIO_API_KEY=

# 服务端口
PORT=3000
