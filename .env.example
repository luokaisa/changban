# ===== 复制成 .env 后填写（.env 已被 gitignore，不会进仓库）=====

# AI 对话（默认走 DeepSeek，见 server/services/openai.js 的 PROVIDER_URLS）
# DeepSeek 用 sk- 开头的 key；换 OpenAI / Moonshot / 通义 / 智谱 就填对应家的 key
OPENAI_API_KEY=

# 声音克隆 + 语音回复（ElevenLabs Instant Voice Clone）
ELEVENLABS_API_KEY=

# 阿里云：短信验证码注册 + 手机号一键登录
# 权限建议只给「短信服务」+「号码认证」，不要开公网白名单
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# Fish Audio（备用 TTS，代码已写但未接入）
FISH_AUDIO_API_KEY=

# 服务端口
PORT=3000

# 微信支付（H5）
# 测试模式：WECHAT_MOCK=true（默认），应用内模拟支付，走通全流程
# 生产：WECHAT_MOCK=false，并填下面 6 项（向 FF 索取商户资料后填）
WECHAT_MOCK=true
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_APIV3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
WECHAT_NOTIFY_URL=https://yourdomain.com/api/pay/notify

# 心意付费开关：false=内测全免费，true=按豆价走心意豆支付（微信充值）
GIFTS_PAY_ENABLED=false

# TTS 语音合成（elevenlabs | doubao）
TTS_PROVIDER=elevenlabs
# 豆包 TTS（FF 提供 API 后填）
DOUBAO_TTS_APPID=
DOUBAO_TTS_TOKEN=
